{
  "name": "RankForge - User Profile Upsert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rankforge-user-profile-upsert",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-user-profile-upsert",
      "name": "Webhook - User Profile Upsert",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst now = new Date().toISOString();\nconst user_id = String(body.user_id || '').trim();\nconst email = String(body.email || '').trim().toLowerCase();\nif (!user_id && !email) {\n  return [{ json: { ok: false, statusCode: 400, error: 'Missing user_id or email' } }];\n}\nconst verticals = Array.isArray(body.target_verticals) ? body.target_verticals : String(body.target_verticals || '').split('|').map(s => s.trim()).filter(Boolean);\nreturn [{\n  json: {\n    event: body.event || 'first_run_setup_completed',\n    user_id,\n    email,\n    agency_size: String(body.agency_size || '').trim(),\n    agency_type: String(body.agency_type || '').trim(),\n    weekly_outreach_goal: String(body.weekly_outreach_goal || '').trim(),\n    target_verticals: verticals.join(' | '),\n    primary_niche: String(body.primary_niche || '').trim(),\n    onboarding_completed: body.onboarding_completed === true || body.onboarding_completed === 'true',\n    onboarding_skipped: body.onboarding_skipped === true || body.onboarding_skipped === 'true',\n    created_at: body.created_at || now,\n    updated_at: now,\n    source: body.source || 'dashboard_first_run'\n  }\n}];"
      },
      "id": "normalize-profile-payload",
      "name": "Normalize Profile Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": "1mFDJKBexMfMn8NZSq7xhES7pHWt4LCEY2Gq-zATHuco",
        "sheetName": "user_profiles",
        "options": {}
      },
      "id": "read-user-profiles",
      "name": "Read user_profiles",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 0],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const profile = $('Normalize Profile Payload').first().json;\nconst rows = $input.all().map((item, index) => ({ ...item.json, __rowIndex: index + 2 }));\nconst existing = rows.find(r => (profile.user_id && String(r.user_id || '').trim() === profile.user_id) || (profile.email && String(r.email || '').trim().toLowerCase() === profile.email));\nreturn [{ json: { ...profile, row_number: existing ? existing.__rowIndex : '', action: existing ? 'updated' : 'inserted' } }];"
      },
      "id": "find-existing-profile-row",
      "name": "Find Existing Profile Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.row_number}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
